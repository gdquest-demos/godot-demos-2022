; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Dodge Demo (GDQuest)"
config/description="This demo shows how to code a mechanic to dodge enemy attacks. The character can't take damage while dodging."
run/main_scene="res://Game.tscn"
config/features=PackedStringArray("4.5")
config/icon="res://icon.png"

[debug]

gdscript/warnings/return_value_discarded=false

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="2d"
window/size/fullscreen=true

[dotnet]

project/assembly_name="Dodge Demo (GDQuest)"

[editor_plugins]

enabled=PackedStringArray()

[gdnative]

singletons=[]

[gui]

theme/custom="res://interface/theme.tres"
common/drop_mouse_on_gui_input_disabled=true
theme/use_hidpi=true

